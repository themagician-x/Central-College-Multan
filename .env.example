# ============================================================
#  Central College Multan — website
#
#  The site needs no secrets. This one value only tells it which
#  origin it is served from, so canonical links, robots.txt and
#  sitemap.xml carry the right domain.
# ============================================================

# Public origin, e.g. https://centralcollege.aqeelahmed.dev
# Leave blank locally and on *.vercel.app — the app falls back to the URL
# Vercel assigns, and to localhost when neither is set.
NEXT_PUBLIC_SITE_URL=
